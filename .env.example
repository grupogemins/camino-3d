# Camino 3D: variáveis de ambiente
# Copie para .env.local. Sem nenhuma variável, o app roda 100% com dados de demonstração.
# Nenhuma chave abaixo vai para o navegador: só variáveis NEXT_PUBLIC_* são expostas ao cliente.

# --- Mapa (público) ---
# Estilo MapLibre. Padrão: OpenFreeMap "liberty" (sem chave). Troque por MapTiler/Stadia se contratar.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# --- Clima ---
# mock (padrão) | open-meteo
WEATHER_PROVIDER=mock
# Uso comercial do Open-Meteo exige plano pago: preencha a chave e a URL do plano comercial.
OPEN_METEO_API_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# --- Rotas ---
# mock (padrão) | openrouteservice
ROUTING_PROVIDER=mock
ORS_API_KEY=

# --- Hospedagens, restaurantes e pontos de interesse ---
# mock (padrão) | google  (o adaptador google é um esboço: falha de propósito até existir contrato)
PLACES_PROVIDER=mock
GOOGLE_PLACES_API_KEY=

# --- Tradução ---
# mock (padrão) | deepl
TRANSLATION_PROVIDER=mock
DEEPL_API_KEY=

# --- Pagamentos ---
# mock (padrão) | stripe. Se STRIPE_SECRET_KEY estiver preenchida, o Stripe é usado.
# Camino Pass é pagamento único (mode=payment): crie dois preços únicos, Pass (EUR 14,99) e Grupo/Família (EUR 34,99).
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_PRICE_PASS=
STRIPE_PRICE_GROUP=
# Cupom do Stripe (id personalizado) com EUR 5 de desconto, usado por LANCAMENTO e pelos códigos de afiliados.
STRIPE_COUPON_PROMO=

# --- Banco (fase 2) ---
# Supabase/PostGIS: aplicar supabase/migrations/0001_init.sql. Ainda não usado pelo MVP (persistência local).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
